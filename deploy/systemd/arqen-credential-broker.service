[Unit]
Description=Arqen host credential broker
After=default.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=%h/.local/bin/arqen credential-broker
Environment=ARQEN_GMAIL_BROKER_SOCKET=%t/arqen/gmail-broker.sock
EnvironmentFile=-%h/.config/arqen/arqen.env
Environment=RUST_BACKTRACE=1
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal

# The broker needs the user's SQLite database, OS keyring, and OAuth client
# configuration. Keep all paths user-owned and provide them through the unit
# environment or the command's normal XDG resolution.

[Install]
WantedBy=default.target
