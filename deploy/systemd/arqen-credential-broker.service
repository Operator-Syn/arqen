[Unit]
Description=Arqen host credential broker
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/arqen credential-broker
Environment=GOOGLE_CLIENT_SECRET=%h/.config/arqen/google-client-secret.json
Environment=RUST_BACKTRACE=1
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
Restart=on-failure
RestartSec=2s

# The broker needs the user's SQLite database, OS keyring, and OAuth client
# configuration. Keep all paths user-owned and provide them through the unit
# environment or the command's normal XDG resolution.

[Install]
WantedBy=default.target
