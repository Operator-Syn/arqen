# Copy to ~/.config/arqen/arqen.env and replace the home path.
# Keep this file mode 0600; it contains paths and service policy.
GOOGLE_CLIENT_SECRET=/home/REPLACE_ME/.config/arqen/google-client-secret.json
ARQEN_MCP_BEARER_TOKEN_FILE=/home/REPLACE_ME/.config/arqen/mcp-bearer-token
ARQEN_MCP_ALLOWED_HOSTS=127.0.0.1:8787
ARQEN_MCP_ALLOWED_ORIGINS=http://127.0.0.1:8787
