# Arqen local development environment
#
# Run `make setup-local` to create the ignored .env from this example. Setup
# copies this file only when .env is absent; later runs do not overwrite it.
# Scripts load .env automatically. Do not put OAuth credentials or a bearer
# token in this tracked example.

# Existing Google OAuth desktop-client JSON used by the TUI and host broker.
# Local repository workflows use this ignored path. Installed user services
# instead use ~/.config/arqen/google-client-secret.json.
GOOGLE_CLIENT_SECRET=.secrets/google-client-secret.json

# Keep the development MCP listener on loopback. Public HTTPS belongs behind
# the Nginx/reverse-proxy example in deploy/nginx/.
# If another local service owns 8787, change the port in all three values.
ARQEN_MCP_LISTEN_ADDR=127.0.0.1:8787
ARQEN_MCP_ALLOWED_HOSTS=127.0.0.1:8787
ARQEN_MCP_ALLOWED_ORIGINS=http://127.0.0.1:8787

# setup-local.sh creates this user-only random file when it is missing.
# The MCP process reads the file; the token value is intentionally not here.
ARQEN_MCP_BEARER_TOKEN_FILE=.secrets/mcp-bearer-token

# The broker derives its default socket from XDG_RUNTIME_DIR. Set this only
# when you need a non-default socket path shared by the broker and MCP server.
# ARQEN_GMAIL_BROKER_SOCKET=/run/user/1000/arqen/gmail-broker.sock

# Docker-native MCP listener port.
ARQEN_MCP_HOST_PORT=8787

# Docker-native stack. It creates a fresh SQLite/OpenBao profile and streams
# the existing TUI at the loopback control port.
ARQEN_DOCKER_PROJECT=arqen-docker
ARQEN_DOCKER_SECRETS_DIR=.secrets
ARQEN_DOCKER_IMAGE_SOURCE=build
# Selects a GHCR release tag only when ARQEN_DOCKER_IMAGE_SOURCE=registry.
ARQEN_DOCKER_IMAGE_TAG=latest
# Local builds use this moving tag in the local-only arqen-local namespace.
# Set a unique value when multiple checkouts share one Docker daemon.
ARQEN_DOCKER_LOCAL_IMAGE_TAG=dev
ARQEN_DOCKER_IMAGE_BUNDLE=out/arqen-docker-stack/docker-images-linux-amd64.tar
# Only set when the bundle manifest is not next to the archive.
# ARQEN_DOCKER_IMAGE_BUNDLE_MANIFEST=/path/to/services.json
ARQEN_CONTROL_HOST_PORT=7681
ARQEN_OAUTH_CALLBACK_HOST_PORT=8765
# Auto-detects Wayland first, then X11. Set this only to override detection.
# ARQEN_DOCKER_DISPLAY_MODE=wayland
# Docker app containers run as this invoking host user so native Wayland/X11
# authorization and shared-volume ownership remain coherent. Auto-detected.
# ARQEN_DOCKER_HOST_UID=1000
# ARQEN_DOCKER_HOST_GID=100

# Use the repository's Nix dev shell when Nix is installed. Set to never to
# use the system cargo/rust toolchain instead.
ARQEN_USE_NIX=auto

# Optional disposable native-smoke listener override; default is 18787.
# ARQEN_MCP_SMOKE_LISTEN_ADDR=127.0.0.1:18787

# Remote OAuth over an SSH local port forward. Keep this disabled for normal
# desktop use; the remote login command sets it explicitly for the VPS TUI.
# ARQEN_OAUTH_REMOTE=1
# ARQEN_OAUTH_CALLBACK_PORT=8765
